{
  "hosting": {
    "public": ".",
    "ignore": ["docs/**", 
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "README.md",
      "package.json",
      "test/**",
      "scripts/**",
      ".git/**",
      "**/.*",
      "**/node_modules/**",
      "storage.rules"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}