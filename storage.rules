rules_version = '2';
// ID and customer photos: any staff may upload, ONLY the owner may view. Role comes from the roles/{uid} document.
service firebase.storage {
  match /b/{bucket}/o {
    function role() { return firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.role; }
    match /customers/{cid}/{file} {
      allow read, update, delete: if request.auth != null && role() == 'owner';
      allow create: if request.auth != null && role() in ['owner', 'manager', 'staff']
        && request.resource.size < 3 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    // Item photos are not sensitive: any staff may view and add them.
    match /items/{iid}/{file} {
      allow read: if request.auth != null && role() in ['owner', 'manager', 'staff'];
      allow create: if request.auth != null && role() in ['owner', 'manager', 'staff']
        && request.resource.size < 3 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow update, delete: if request.auth != null && role() == 'owner';
    }
    // Completed Form 4473 scans: staff may add them, only owner/manager may view.
    match /firearms/{tid}/{file} {
      allow read: if request.auth != null && role() in ['owner', 'manager'];
      allow create: if request.auth != null && role() in ['owner', 'manager', 'staff'] && request.resource.size < 3 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
