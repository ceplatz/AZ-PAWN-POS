rules_version = '2';
// SKELETON: source of truth for access control. Role comes from a roles document
// (the roles/{uid} document, edited only in the Firebase console by the owner). Tighten per collection as each module is built.
service cloud.firestore {
  match /databases/{db}/documents {
    function role() { return get(/databases/$(db)/documents/roles/$(request.auth.uid)).data.role; }
    function signedIn() { return request.auth != null && exists(/databases/$(db)/documents/roles/$(request.auth.uid)); }
    function isOwner() { return signedIn() && role() == 'owner'; }
    function isMgr() { return signedIn() && role() in ['owner', 'manager']; }
    function isStaff() { return signedIn() && role() in ['owner', 'manager', 'staff']; }

    // Staff may update contact details only; flags (police / do-not-buy) and everything else are owner-only.
    match /customers/{id}   { allow read, create: if isStaff(); allow delete: if false;
      allow update: if isOwner() || (isStaff() && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['phone', 'email', 'address', 'updatedAt', 'updatedBy'])); }
    // Full ID images/numbers are owner-only; keep them in a separate doc.
    // Staff can see the full ID number (owner decision). ID PHOTOS stay owner-only, in storage.rules.
    match /customerIds/{id} { allow create, read: if isStaff(); allow update: if isOwner(); allow delete: if false; }
    // Staff can add and view items; only managers/owner change them afterward (price, location, release from hold).
    match /items/{id}       { allow read, create: if isStaff(); allow delete: if false;
      allow update: if isMgr()
        // counter: redeeming a pawn releases the collateral
        || (isStaff() && resource.data.status == 'collateral-active' && request.resource.data.status == 'released' && resource.data.get('isFirearm', false) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy']))
        // counter: a sale. Item must be for sale, or its hold must have ended (checked here against server time).
        || (isStaff() && request.resource.data.status == 'sold' && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'soldDate', 'soldPrice', 'saleId', 'updatedAt', 'updatedBy'])
            && (resource.data.status == 'for-sale'
                || (resource.data.status == 'on-hold' && resource.data.get('holdUntilMs', null) != null
                    && resource.data.holdUntilMs <= request.time.toMillis()))
            && resource.data.get('isFirearm', false) == false)
        // counter: a FIREARM sale. Allowed only with a NICS "Proceed" transfer record written in the same transaction.
        || (isStaff() && request.resource.data.status == 'sold' && resource.data.get('isFirearm', false) == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'soldDate', 'soldPrice', 'saleId', 'updatedAt', 'updatedBy'])
            && (resource.data.status == 'for-sale'
                || (resource.data.status == 'on-hold' && resource.data.get('holdUntilMs', null) != null && resource.data.holdUntilMs <= request.time.toMillis()))
            && existsAfter(/databases/$(db)/documents/firearmTransfers/$(request.resource.data.saleId))
            && getAfter(/databases/$(db)/documents/firearmTransfers/$(request.resource.data.saleId)).data.nicsResult == 'Proceed'
            && getAfter(/databases/$(db)/documents/firearmTransfers/$(request.resource.data.saleId)).data.itemId == resource.id)
        // counter: first A&D entry links the item
        || (isStaff() && resource.data.get('adEntryId', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adEntryId', 'adEntryNumber', 'firearmType', 'updatedAt', 'updatedBy']))
        // counter: pawned firearm returned to the customer, with a Proceed transfer record (when settings require it)
        || (isStaff() && resource.data.status == 'collateral-active' && request.resource.data.status == 'released' && resource.data.get('isFirearm', false) == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'releaseTransferId', 'updatedAt', 'updatedBy'])
            && ((exists(/databases/$(db)/documents/config/settings)
                  && !get(/databases/$(db)/documents/config/settings).data.get('firearms', {}).get('redemptionNeedsTransfer', true))
                || (existsAfter(/databases/$(db)/documents/firearmTransfers/$(request.resource.data.releaseTransferId))
                    && getAfter(/databases/$(db)/documents/firearmTransfers/$(request.resource.data.releaseTransferId)).data.nicsResult == 'Proceed'
                    && getAfter(/databases/$(db)/documents/firearmTransfers/$(request.resource.data.releaseTransferId)).data.itemId == resource.id))); }
    // Staff run the counter (issue, redeem, renew); only whitelisted fields may change, and only managers/owner may forfeit.
    match /loans/{id}       { allow read, create: if isStaff(); allow delete: if false;
      allow update: if isStaff() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'originDate', 'renewals', 'closedDate', 'history', 'updatedAt', 'updatedBy'])
        && (request.resource.data.status != 'forfeited' || isMgr()); }
    match /loans/{id}       { allow update: if isMgr() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['policeReport', 'updatedAt', 'updatedBy']); }
    // Sequential pawn ticket numbers: the counter may only ever go up by exactly one.
    match /counters/{doc}   { allow read: if isStaff(); allow create: if isStaff() && request.resource.data.next is int;
      allow update: if isStaff() && request.resource.data.next == resource.data.next + 1; }
    // Purchases are permanent records. Only a manager may update the police-report status.
    match /purchases/{id}   { allow read, create: if isStaff(); allow delete: if false;
      allow update: if isMgr() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['policeReport', 'updatedAt', 'updatedBy']); }
    // Sales are permanent records (returns/voids will be new records created by the owner).
    match /sales/{id}       { allow read, create: if isStaff(); allow update, delete: if false; }
    // ---- Firearms: append-only records ----
    match /adBook/{id}      { allow read, create: if isStaff(); allow delete: if false;
      allow update: if isStaff() && resource.data.get('disp', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disp', 'updatedAt', 'updatedBy']); }   // a disposition can be added once
    match /firearmTransfers/{id} { allow read: if isStaff(); allow create: if isStaff() && request.resource.data.nicsResult == 'Proceed'; allow update, delete: if false; }
    match /firearmChecks/{id}    { allow read: if isStaff(); allow create: if isStaff(); allow update, delete: if false; }
    match /transactions/{id}{ allow create: if isStaff() && (!(request.resource.data.type in ['expense', 'payout']) || isMgr()); allow read: if isMgr(); allow update, delete: if false; } // voids are new records
    // Users may read only their own role; nobody can write roles from the app (console only).
    match /roles/{uid}      { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    // Each manager/owner can read and write only their own PIN record (salted hash + lockout counters).
    match /pins/{uid}       { allow read, write: if isMgr() && request.auth.uid == uid; }
    match /config/{doc}     { allow read: if isStaff(); allow write: if isOwner(); }
    // Every settings change is logged (before/after). Append-only, owner-readable.
    match /settingsLog/{id} { allow create: if isOwner(); allow read: if isOwner(); allow update, delete: if false; }
    // ---- Operations ----
    match /timeEntries/{id} { allow read: if isMgr() || (isStaff() && resource.data.employeeUid == request.auth.uid);
      allow create: if isStaff() && request.resource.data.employeeUid == request.auth.uid && request.resource.data.outAt == null; allow delete: if false;
      allow update: if (isStaff() && resource.data.employeeUid == request.auth.uid && resource.data.outAt == null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outAt']))
        || (isMgr() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inAt', 'outAt', 'adjustedBy', 'adjustedAt', 'note'])); }
    match /drawerCounts/{id} { allow read, create: if isMgr(); allow update, delete: if false; }
    match /messages/{id}    { allow read: if isStaff() && (resource.data.audience == 'all' || isMgr()); allow delete: if false;
      allow create: if isStaff() && request.resource.data.fromUid == request.auth.uid && request.resource.data.audience in ['all', 'managers'];
      allow update: if isStaff() && (resource.data.audience == 'all' || isMgr()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']); }
    match /reminders/{id}   { allow read: if isStaff(); allow create, update: if isMgr(); allow delete: if isOwner(); }
    match /reminderLog/{id} { allow read, create: if isStaff(); allow update, delete: if false; }
    match /{path=**}        { allow read, write: if false; }
  }
}
