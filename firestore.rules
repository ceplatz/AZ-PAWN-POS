rules_version = '2';
// SKELETON: source of truth for access control. Role comes from a custom claim
// (request.auth.token.role). Tighten per collection as each module is built.
service cloud.firestore {
  match /databases/{db}/documents {
    function role() { return request.auth.token.role; }
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && role() == 'owner'; }
    function isMgr() { return signedIn() && role() in ['owner', 'manager']; }
    function isStaff() { return signedIn() && role() in ['owner', 'manager', 'staff']; }

    match /customers/{id}   { allow read, create, update: if isStaff(); allow delete: if false; }
    // Full ID images/numbers are owner-only; keep them in a separate doc.
    match /customerIds/{id} { allow read, write: if isOwner(); }
    match /items/{id}       { allow read, create, update: if isStaff(); allow delete: if false; }
    match /loans/{id}       { allow read, create, update: if isStaff(); allow delete: if false; }
    match /transactions/{id}{ allow read, create: if isStaff(); allow update, delete: if false; } // voids are new records
    match /config/{doc}     { allow read: if isStaff(); allow write: if isOwner(); }
    match /{path=**}        { allow read, write: if false; }
  }
}
